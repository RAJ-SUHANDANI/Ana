# OpenRouter is ANA's primary chat provider.
# In Cloudflare, add OPENROUTER_API_KEY as a Worker Secret.
# Never commit a real API key to this file or to Git.
OPENROUTER_API_KEY=

# Optional. Defaults to OpenRouter's free-model router.
# If set, this must be "openrouter/free" or a model ID ending in ":free".
OPENROUTER_MODEL=openrouter/free

# Cloudflare Workers AI remains an optional fallback through the AI binding
# already declared in wrangler.jsonc. No model is downloaded to the browser.
