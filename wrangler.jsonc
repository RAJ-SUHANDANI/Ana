{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ana-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ana-ai.<YOUR-SUBDOMAIN>.workers.dev"
  }
}
